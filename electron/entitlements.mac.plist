<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS Hardened Runtime entitlements for CommandDeck.

  Required for App Store distribution and Notarization.

  node-pty requires:
    com.apple.security.cs.allow-unsigned-executable-memory
    (PTY helper is spawned as an unsigned process)

  Electron itself requires:
    com.apple.security.cs.allow-jit
-->
<plist version="1.0">
<dict>
  <!-- Electron requires JIT for the V8 engine -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>

  <!-- node-pty requires executing unsigned helper processes -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Allow dynamic library loading (native Node addons: better-sqlite3, node-pty) -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Network access: required for the embedded HTTP/WebSocket server -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>

  <!-- Filesystem: workspace folders, SQLite database -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
