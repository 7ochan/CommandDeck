{
  "name": "command-deck",
  "version": "0.1.9",
  "private": true,
  "description": "A local-first visual terminal workspace.",
  "author": {
    "name": "CommandDeck",
    "email": "hello@commanddeck.app"
  },
  "homepage": "https://commanddeck.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7ochan/CommandDeck.git"
  },
  "type": "module",
  "main": ".electron/main.js",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "next build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node .server/server.js --production",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "verify:terminal": "npm run build && tsx scripts/verify-terminal.ts",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run electron:compile && electron .",
    "electron:build": "npm run build && npm run electron:compile",
    "electron:start": "electron .",
    "electron:package": "npm run electron:build && npx electron-builder --config electron-builder.yml",
    "electron:package:mac": "npm run electron:build && npx electron-builder --mac --config electron-builder.yml",
    "electron:package:win": "npm run electron:build && npx electron-builder --win --config electron-builder.yml",
    "electron:package:linux": "npm run electron:build && npx electron-builder --linux --config electron-builder.yml",
    "electron:publish": "npm run electron:build && npx electron-builder --publish always --config electron-builder.yml",
    "electron:publish:mac": "npm run electron:build && npx electron-builder --mac --publish always --config electron-builder.yml"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.3"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "better-sqlite3": "^13.0.1",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "next": "16.2.11",
    "node-pty": "1.2.0-beta.14",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.22",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true,
    "node-pty@1.2.0-beta.14": true,
    "electron@43.2.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  },
  "build": {
    "appId": "com.commanddeck.app",
    "productName": "CommandDeck",
    "extends": null
  }
}
